# OpenAI sozlamalari
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_WRITING_MODEL=gpt-4o-mini

# Ilova xavfsizlik kaliti (uzun tasodifiy satr: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Muhit va proksi
APP_ENV=production
PROXY_HOPS=1

# Ma'lumotlar bazasi (PostgreSQL uchun masalan: postgresql://user:pass@host/dbname, aks holda SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/cefr

# Kunlik AI limitlari
AI_GLOBAL_DAILY_CAP=0
SPEAKING_PER_DAY=10
LISTENING_PLAYS=2

# Email (SMTP) - Parolni tiklash va email tasdiqlash uchun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Levi <no-reply@yourdomain.uz>
VERIFY_EMAIL=0

# Telegram Bot (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Aloqa
PRIVACY_CONTACT=admin@yourdomain.uz
